<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Testes da lógica pura do SIPOS (sem Windows Forms nem Office interop):
    programa Modelar, planeamento de dias, feriados e a colocação dos blocos
    pelo ExecutorModelar sobre um documento de texto simulado.

    Correr (Windows ou Linux), a partir desta pasta:  dotnet run
  -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>SIPOS.Logic.Tests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\..\ModelarPrograma.cs" Link="Fonte\ModelarPrograma.cs" />
    <Compile Include="..\..\Feriados.cs" Link="Fonte\Feriados.cs" />
  </ItemGroup>

</Project>
